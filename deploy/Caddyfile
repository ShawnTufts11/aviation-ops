# ── Development (HTTP only, for local / Tailscale) ─────────────
:80 {
    reverse_proxy frontend:80

    handle_path /api/* {
        reverse_proxy backend:8000
    }

    handle_path /ws/* {
        reverse_proxy backend:8000
    }

    handle_path /docs {
        reverse_proxy backend:8000
    }

    handle_path /openapi.json {
        reverse_proxy backend:8000
    }

    encode gzip
    header /api/* Access-Control-Allow-Origin "*"
}
