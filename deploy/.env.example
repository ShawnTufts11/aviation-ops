# ParaRig Aviation Operations Suite — Environment Variables
# Copy this to .env and fill in the values.

# ── Database ────────────────────────────────────────────────────
# Production (PostgreSQL)
DB_PASSWORD=CHANGE_ME_PLEASE
DATABASE_URL=postgresql+asyncpg://pararig:${DB_PASSWORD}@postgres:5432/pararig_ops
# Development (SQLite — uncomment to use instead of PostgreSQL)
# DATABASE_URL=sqlite+aiosqlite:///./pararig_ops.db

# ── Auth / JWT ──────────────────────────────────────────────────
SECRET_KEY=generate-a-64-char-hex-key-with-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
MFA_ENCRYPTION_KEY=another-32-char-key-for-encrypting-mfa-secrets

# ── Application ─────────────────────────────────────────────────
ENVIRONMENT=development
INSTANCE_MODE=self_hosted
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
LOG_LEVEL=INFO

# ── Storage ─────────────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
# S3_ENDPOINT=
# S3_BUCKET=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ── External APIs ───────────────────────────────────────────────
# ADS-B / Flight Tracking
# ADSB_API_KEY=
# OPENSKY_USERNAME=
# OPENSKY_PASSWORD=

# Weather (Open-Meteo — no API key needed for basic use)

# ── Notifications ───────────────────────────────────────────────
# SMTP (email notifications)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=ops@pararig.com

# SMS (Twilio — optional)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# ── Stripe (SaaS mode only) ─────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID_MONTHLY=
# STRIPE_PRICE_ID_YEARLY=

# ── Licensing (self-hosted) ─────────────────────────────────────
# LICENSE_KEY=
